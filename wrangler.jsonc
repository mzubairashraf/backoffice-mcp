{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "backoffice-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-06-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },

  // Local development values. `wrangler deploy --env production` uses the block below.
  "vars": {
    "MCP_RESOURCE": "http://localhost:8787/mcp",
    "AUTH_MODE": "demo"
  },
  "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "local-oauth-kv" }],
  "d1_databases": [
    { "binding": "DB", "database_name": "backoffice-mcp", "database_id": "local-backoffice-db", "migrations_dir": "migrations" }
  ],

  "env": {
    "production": {
      "name": "backoffice-mcp",
      "vars": {
        // Replace with the deployed URL, then deploy again.
        "MCP_RESOURCE": "https://backoffice-mcp.zashraf-b88.workers.dev/mcp",
        "AUTH_MODE": "github",
        "GITHUB_CLIENT_ID": "Ov23limIesFzN1ZsJCsj"
      },
      // Secrets, set with `wrangler secret put --env production`:
      //   CONFIRMATION_SECRET, GITHUB_CLIENT_SECRET
      "kv_namespaces": [{ "binding": "OAUTH_KV", "id": "d3fe6c59286f4671b7ece7e35afeeba4" }],
      "d1_databases": [
        { "binding": "DB", "database_name": "backoffice-mcp", "database_id": "6a2990c7-e18e-46e6-8507-faa45e1ac624", "migrations_dir": "migrations" }
      ]
    }
  }
}
